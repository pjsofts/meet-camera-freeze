{
  "manifest_version": 3,
  "name": "Meet Camera Freeze",
  "version": "1.0.0",
  "description": "Freeze the last camera frame in Google Meet on command (hotkey, toolbar popup, or on-screen button).",
  "permissions": ["activeTab"],
  "host_permissions": ["https://meet.google.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Meet Camera Freeze"
  },
  "commands": {
    "toggle-freeze": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Freeze / unfreeze the camera"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true
    }
  ]
}
